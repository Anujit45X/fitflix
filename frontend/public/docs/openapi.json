  "components": {
    "schemas": {
      "ProfileRequest": {
        "type": "object",
        "properties": {
          "age": {
            "type": "integer",
            "format": "int32",
            "maximum": 100,
            "minimum": 18
          },
          "sex": {
            "type": "string",
            "pattern": "MALE|FEMALE"
          },
          "height": {
            "type": "number",
            "format": "double",
            "maximum": 250,
            "minimum": 100
          },
          "weight": {
            "type": "number",
            "format": "double",
            "maximum": 350,
            "minimum": 30
          },
          "targetWeight": {
            "type": "number",
            "format": "double",
            "maximum": 350,
            "minimum": 30
          },
          "activity": {
            "type": "string",
            "pattern": "SEDENTARY|LIGHT|MODERATE|VERY_ACTIVE"
          },
          "goal": {
            "type": "string",
            "pattern": "LOSE|MAINTAIN|GAIN"
          },
          "diet": {
            "type": "string",
            "pattern": "ANY|VEGETARIAN|VEGAN"
          },
          "waterTarget": {
            "type": "integer",
            "format": "int32",
            "maximum": 6000,
            "minimum": 500
          },
          "timezone": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "activity",
          "diet",
          "goal",
          "sex",
          "timezone"
        ]
      },
      "Item": {
        "type": "object",
        "properties": {
          "foodId": {
            "type": "integer",
            "format": "int64"
          },
          "grams": {
            "type": "number",
            "format": "double",
            "maximum": 2000,
            "minimum": 1
          }
        },
        "required": [
          "foodId"
        ]
      },
      "MealRequest": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "mealType": {
            "type": "string",
            "pattern": "BREAKFAST|LUNCH|DINNER|SNACKS"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "maxItems": 30,
            "minItems": 0
          }
        },
        "required": [
          "date",
          "items",
          "mealType"
        ]
      },
      "Targets": {
        "type": "object",
        "properties": {
          "calories": {
            "type": "number",
            "format": "double",
            "maximum": 5000,
            "minimum": 1200
          },
          "protein": {
            "type": "number",
            "format": "double",
            "maximum": 300,
            "minimum": 30
          },
          "carbs": {
            "type": "number",
            "format": "double",
            "maximum": 700,
            "minimum": 0
          },
          "fat": {
            "type": "number",
            "format": "double",
            "maximum": 200,
            "minimum": 20
          },
          "fiber": {
            "type": "number",
            "format": "double",
            "maximum": 60,
            "minimum": 10
          },
          "water": {
            "type": "integer",
            "format": "int32",
            "maximum": 6000,
            "minimum": 500
          }
        }
      },
      "Weight": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "kg": {
            "type": "number",
            "format": "double",
            "maximum": 350,
            "minimum": 30
          }
        },
        "required": [
          "date"
        ]
      },
      "Water": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "ml": {
            "type": "integer",
            "format": "int32",
            "maximum": 3000,
            "minimum": 1
          }
        },
        "required": [
          "date"
        ]
      },
      "Saved": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "mealType": {
            "type": "string",
            "pattern": "BREAKFAST|LUNCH|DINNER|SNACKS"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "maxItems": 30,
            "minItems": 0
          },
          "plannedDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "items",
          "mealType",
          "name"
        ]
      },
      "Copy": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "date"
        ]
      },
      "CustomFood": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 300,
            "minLength": 0
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "calories": {
            "type": "number",
            "format": "double",
            "maximum": 1000,
            "minimum": 0
          },
          "protein": {
            "type": "number",
            "format": "double",
            "maximum": 100,
            "minimum": 0
          },
          "carbs": {
            "type": "number",
            "format": "double",
            "maximum": 100,
            "minimum": 0
          },
          "fat": {
            "type": "number",
            "format": "double",
            "maximum": 100,
            "minimum": 0
          },
          "fiber": {
            "type": "number",
            "format": "double",
            "maximum": 100,
            "minimum": 0
          },
          "sugar": {
            "type": "number",
            "format": "double",
            "maximum": 100,
            "minimum": 0
          },
          "sodium": {
            "type": "number",
            "format": "double",
            "maximum": 50000,
            "minimum": 0
          }
        },
        "required": [
          "category",
          "name"
        ]
      },
      "Favorite": {
        "type": "object",
        "properties": {
          "foodId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "foodId"
        ]
      },
      "Reset": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9_-]{64}"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 12
          }
        },
        "required": [
          "password",
          "token"
        ]
      },
      "Register": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 12
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Forgot": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          }
        },
        "required": [
          "email"
        ]
      },
      "Activity": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "steps": {
            "type": "integer",
            "format": "int32",
            "maximum": 100000,
            "minimum": 0
          },
          "minutes": {
            "type": "integer",
            "format": "int32",
            "maximum": 600,
            "minimum": 0
          }
        },
        "required": [
          "date"
        ]
      }
    }
  }
}