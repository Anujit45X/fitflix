# Local Docker configuration. Generate actual secrets with scripts/configure_local.py.
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
APP_ORIGIN=http://localhost:8088
SECURE_COOKIE=false
DEMO_MODE=false
DEMO_PASSWORD=REPLACE_WITH_RANDOM_DEMO_PASSWORD
WEB_PORT=8088
# Native development additionally sets these in the process environment:
# DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/fitflix
# DATABASE_USER=fitflix
# PORT=8080
# SERVER_ADDRESS=127.0.0.1
# FLYWAY_ENABLED=true only for local development or the release migration job.
# Production serving API: FLYWAY_ENABLED=false after successful migration job.
# Production: HTTPS origin, SECURE_COOKIE=true, DEMO_MODE=false, secret manager.

# Recovery: supply an authenticated SMTP provider before enabling.
MAIL_ENABLED=false
MAIL_FROM=noreply@your-domain.example
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true
